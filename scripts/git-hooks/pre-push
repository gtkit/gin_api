#!/usr/bin/env bash
# gin-api-managed-hook —— 由 `make hooks` 安装，改动请改仓库里的
# scripts/git-hooks/pre-push 后重跑 `make hooks`。
#
# 推送前执行 `make check-ci`。CI 侧只负责部署、不承载质量 job（属外部冻结
# 契约），所以这一道是代码进入共享历史前唯一的自动检查点。
#
# 为什么挂 pre-push 而不是 pre-commit：门禁是分钟级的（race 测试 + 覆盖率），
# 挂在每次提交上的结果必然是被 `--no-verify` 长期绕过，等于
# 没装。一次推送对应一次完整验证，粒度才对得上。
#
# 跳过：`SKIP_GATE=1 git push`。绕过路径故意留着——做得难用只会让人把钩子
# 整个卸掉，那比留痕的绕过更糟。
set -euo pipefail

if [ "${SKIP_GATE:-}" = "1" ]; then
	echo "⚠️  SKIP_GATE=1：质量门禁被跳过，本次推送的内容未经验证。" >&2
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "▶️ pre-push：make check-ci"
if ! make check-ci; then
	echo "" >&2
	echo "推送被拦下：make check-ci 未通过。" >&2
	echo "修复后重试；确需跳过用 SKIP_GATE=1 git push。" >&2
	exit 1
fi
