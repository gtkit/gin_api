package {{.Name}}

import (
    "context"
    "errors"
    "{{.Module}}/internal/models"
    "{{.Module}}/internal/module/{{.Name}}/application"
    "{{.Module}}/internal/repository/dbtx"
    recordrepo "{{.Module}}/internal/repository/{{.Name}}"
    "gorm.io/gorm"
)

func New(db *gorm.DB) (*application.Service, error) {
    if db == nil { return nil, errors.New("record database is required") }
    return application.New(adapter{repo:recordrepo.New(db)}, dbtx.NewManager(db))
}
type adapter struct { repo *recordrepo.Repository }
func value(record models.{{.Type}}Record) application.Record {
    return application.Record{ID:record.ID, Title:record.Title, CreatedAt:record.CreatedAt, UpdatedAt:record.UpdatedAt}
}
func model(owner int64, record application.Record) models.{{.Type}}Record {
    return models.{{.Type}}Record{ID:record.ID, OwnerID:owner, Title:record.Title, CreatedAt:record.CreatedAt, UpdatedAt:record.UpdatedAt}
}
func (a adapter) Find(ctx context.Context, owner int64, id string) (application.Record, bool, error) {
    record, found, err := a.repo.Find(ctx, owner, id); return value(record), found, err
}
func (a adapter) List(ctx context.Context, owner int64, offset, limit int) ([]application.Record, int64, error) {
    records, total, err := a.repo.List(ctx, owner, offset, limit)
    values := make([]application.Record, 0, len(records)); for _, record := range records { values = append(values, value(record)) }; return values, total, err
}
func (a adapter) Create(ctx context.Context, owner int64, record application.Record) error { return a.repo.Create(ctx, model(owner,record)) }
func (a adapter) Update(ctx context.Context, owner int64, record application.Record) (bool,error) { return a.repo.Update(ctx, model(owner,record)) }
func (a adapter) Delete(ctx context.Context, owner int64, id string) (bool,error) { return a.repo.Delete(ctx,owner,id) }
var _ application.Repository = adapter{}
