# compose.env.example —— 本地开发依赖的环境变量模板。
#
# 用法： cp compose.env.example .env    然后填入本机密码。
# .env 已被 .gitignore 排除，绝不入库；本模板不含任何真实密码。
#
# 这些只服务于本地开发依赖（compose.yaml），与应用自身的
# config/env/env.yml 是两回事，不要混用。

DEV_MYSQL_ROOT_PASSWORD=
DEV_MYSQL_DATABASE=gin_api_dev
DEV_MYSQL_PORT=3306

DEV_REDIS_PASSWORD=
DEV_REDIS_PORT=6379
