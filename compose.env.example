# compose.env.example —— 本地开发依赖的环境变量模板。
#
# 用法： cp compose.env.example .env    然后填入本机密码。
# .env 已被 .gitignore 排除，绝不入库；本模板不含任何真实密码。
#
# 以下DEV_*仅供compose.yaml插值；APP_*是应用配置覆盖，二者不要混用。

DEV_MYSQL_ROOT_PASSWORD=
DEV_MYSQL_DATABASE=gin_api_dev
DEV_MYSQL_PORT=3306

DEV_REDIS_PASSWORD=
DEV_REDIS_PORT=6379

# app profile的宿主HTTP端口，默认8008；1..65535，仅绑定127.0.0.1。
DEV_APP_PORT=8008
# 容器运行身份；UID必须>0（入口拒绝root），GID为非负整数。
# 取宿主id -u/id -g，使0600私钥可读、日志目录可写；默认1000:1000。
DEV_APP_UID=1000
DEV_APP_GID=1000
# 隔离运行配置文件；默认下列路径，空值也回落此路径；必须预先存在。
# 文件中的JWT路径须指向/app/config/pem下的挂载文件，redis.prefix须独占。
DEV_APP_CONFIG=./config/env/env.yml
# 私密密钥目录，只读挂载到/app/config/pem；必须存在，私钥0600/公钥0644。
# 默认下列目录，空值回落；所有权须匹配DEV_APP_UID，不能放宽私钥权限。
DEV_APP_PEM_DIR=./config/pem
# 已有可写日志目录，默认下列路径，空值回落；容器路径固定/app/logs/app。
DEV_APP_LOG_DIR=./logs
# 应用访问MySQL的地址/端口；空值回落mysql:3306（compose服务名/容器端口）。
# 复用已有服务时显式设可达的本机地址；Docker Desktop可用host.docker.internal。
DEV_APP_DB_HOST=mysql
DEV_APP_DB_PORT=3306
# 应用测试库；默认/空值回落DEV_MYSQL_DATABASE（后者缺省gin_api_dev）。
# 必须先应用本仓既有迁移；启动不自动执行DDL，不填生产库。
DEV_APP_DB_NAME=
# 应用连接用户，默认/空值回落root；仅用于本地开发。
DEV_APP_DB_USER=root
# 可选应用DB密码：未设置时继承DEV_MYSQL_ROOT_PASSWORD；显式空值保留为空。
# 仅复用确实无密码的本机测试库时取消下一行注释，不填生产凭据。
# DEV_APP_DB_PASSWORD=
# 应用Redis地址，默认/空值回落redis:6379；复用已有服务时设本机可达地址。
DEV_APP_REDIS_ADDR=redis:6379
# 可选应用Redis密码：未设置时继承DEV_REDIS_PASSWORD；显式空值保留为空。
# DEV_APP_REDIS_PASSWORD=
# Docker构建的Go依赖代理；默认/空值回落下列公开代理，不改变go.mod版本。
DEV_GOPROXY=https://proxy.golang.org,direct
# DEV_APP_NAME由Make从project.mk注入，DEV_BUILD_COMMIT/DEV_BUILD_TIME由Make构建参数注入。
# 直接Compose构建须显式提供名称；追溯字段不提供时显示unknown。
# COMPOSE_ENV_FILE与COMPOSE_PROJECT是Make参数（默认.env、project.mk的APP_NAME），
# 在make命令行设置，不依赖本文件向Make反向注入变量。
