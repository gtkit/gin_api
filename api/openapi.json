{
  "openapi": "3.1.0",
  "info": {
    "title": "gin_api",
    "version": "1.0.0",
    "description": "Public HTTP contract generated from the route descriptors."
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "User"
    }
  ],
  "paths": {
    "/api/v1/user": {
      "get": {
        "operationId": "getCurrentUserProfile",
        "tags": [
          "User"
        ],
        "summary": "Get the current user profile",
        "security": [
          {
            "AppToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "500": {
            "description": "Internal error"
          }
        }
      },
      "put": {
        "operationId": "updateCurrentUserProfile",
        "tags": [
          "User"
        ],
        "summary": "Update the current user profile",
        "security": [
          {
            "AppToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "422": {
            "description": "Request payload failed validation"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/api/v1/user/deactivate": {
      "post": {
        "operationId": "deactivateCurrentUser",
        "tags": [
          "User"
        ],
        "summary": "Deactivate the current user account",
        "security": [
          {
            "AppToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "422": {
            "description": "Request payload failed validation"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "503": {
            "description": "Not ready to receive traffic"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AppToken": {
        "type": "apiKey",
        "in": "header",
        "name": "App-Token"
      }
    }
  }
}
