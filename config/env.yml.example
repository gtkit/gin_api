# ============================================================================
# config/env.yml.example —— 运行配置模板（唯一进 git 的参照文件）
# ============================================================================
#
# 用法：
#   cp config/env.yml.example config/env/env.yml   # 复制后按本机/本环境填写真实值
#
# 重要约定：
#   1. config/env/env.yml 不进 git（见 .gitignore），由开发本机、
#      测试服、生产服各自维护一份；本模板进 git，仅供参照、不含任何真实密钥。
#   2. 标【密钥】的字段：真实值只写进各机自己的 config/env.yml，本模板一律留空。
#   3. 标【文件挂载】的字段：值是磁盘文件路径，证书/多行 PEM 由部署单独提供文件，
#      不要把 PEM 内容直接贴进 yaml。
#   4. 标【必填】的字段：缺失或为空会导致 Validate 失败、进程启动即报错退出。
#   5. 每台机的 config/env.yml 只放该环境自己的配置，绝不混入其它环境的密钥。
# ----------------------------------------------------------------------------

# 【必填】运行环境标识，取值 dev | test | prod。
# 决定路由版本化、日志中的环境名、以及代码里的 IsDev()/IsTest()/IsProd() 判定。
env: dev

# ---------------------------------------------------------------------------
# 应用 / HTTP 服务
# ---------------------------------------------------------------------------
application:
  domain: "https://example.com"   # 站点对外访问域名（用于拼接回调地址等）
  host: 0.0.0.0                    # 【必填】监听地址：本地可用 localhost，线上用 0.0.0.0
  ishttps: false                   # 是否以 HTTPS 对外（一般由前置网关终止 TLS，这里多为 false）
  name: app_client                 # 【必填】应用名，用于日志与运行标识
  port: "8008"                     # 【必填】HTTP 监听端口，字符串形式
  readtimeout: 2                   # HTTP 读超时（秒），需 >= 0
  writertimeout: 1                 # HTTP 写超时（秒），需 >= 0
  timezone: "Asia/Shanghai"        # 【必填】时区，须为合法 IANA 时区名

# ---------------------------------------------------------------------------
# 数据库（MySQL）
# ---------------------------------------------------------------------------
database:
  dbtype: mysql                    # 【必填】数据库类型，当前为 mysql
  host: 127.0.0.1                  # 【必填】数据库地址
  port: "3306"                     # 【必填】数据库端口
  name: sleep                      # 【必填】库名
  username: root                   # 【必填】用户名
  password: ""                     # 【密钥】数据库密码
  maxidleconn: 50                  # 连接池最大空闲连接数
  maxopenconn: 25                  # 连接池最大打开连接数
  maxlifeseconds: 30               # 连接最大存活时间（秒）

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
redis:
  addr: 127.0.0.1:6379             # 【必填】Redis 地址 host:port
  password: ""                     # 【密钥】Redis 密码（无密码留空）
  dbs: [0, 1, 2]                   # 【必填】使用的 db 编号列表
  prefix: ""                       # key 统一前缀（可选）


# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
log:
  level: info                      # 【必填】日志级别：debug / info / warn / error
  path: ./logs/app_client          # 【必填】常规日志路径；生产绝对路径必须位于 APP_ROOT 下
  sql: 0                           # 是否逐条打印 SQL（1 开 0 关）；生产默认 0。
                                   # 无论开关：SQL 日志已在代码层强制参数化，错误/慢查询日志不落真实绑定参数。
  compress: 1                      # 归档日志是否压缩（maxsize/maxage/maxbackups/compress 均实际生效）
  consolestdout: 1                 # 是否输出到控制台
  filestdout: 1                    # 是否输出到文件
  maxage: 30                       # 日志保留天数
  maxbackups: 30                   # 日志最大保留份数
  maxsize: 100                     # 单个日志文件大小上限（MB）


# ---------------------------------------------------------------------------
# 邮件（SMTP，经 gtkit/tools/mailx 发信；host 留空 = 不启用，启动时跳过装配）
# ---------------------------------------------------------------------------
email:
  alias: ""                        # 发件人显示别名
  host: ""                         # SMTP 服务器地址；留空则不装配邮件客户端
  user: ""                         # SMTP 账号，同时作为发件人地址（须为合法邮箱）
  pass: ""                         # 【密钥】SMTP 密码 / 授权码
  port: 465                        # SMTP 端口；465 自动走隐式 SSL，其余端口强制 STARTTLS

# ---------------------------------------------------------------------------
# 短信验证码
# ---------------------------------------------------------------------------
sms:
  enabled: false                   # 是否启用短信；为 true 时下方 aliyun.sms_* 变为【必填】
  send_limit_enabled: false        # 是否开启 60 秒发送频控（生产建议 true）
  delete_code_on_verify: false     # 验证成功后是否立即作废 code 防重放（生产建议 true）
  allow_test_codes: false          # 是否允许测试白名单手机号用固定测试码（仅联调用）
  test_phones: []                  # 测试白名单手机号列表
  test_code: ""                    # 测试固定验证码
  code_ttl_seconds: 300            # 验证码有效期（秒）
  max_verify_attempts: 5           # 单个验证码最大校验尝试次数

# ---------------------------------------------------------------------------
# 支付
# ---------------------------------------------------------------------------
pay:
  # 微信支付 V3。enabled=true 时 app_id / mch_id / mch_cert_serial_number /
  # mch_apiv3_key 及商户私钥（path 或 pem 二选一）均为【必填】。
  wechat:
    enabled: false
    app_id: ""                          # 公众号/小程序 AppID（非密钥）
    mch_id: ""                          # 商户号（非密钥）
    mch_cert_serial_number: ""          # 商户证书序列号（非密钥）
    mch_apiv3_key: ""                   # 【密钥】APIv3 密钥
    mch_private_key_path: ""            # 【文件挂载】商户私钥文件路径（与下方 PEM 二选一）
    # mch_private_key_pem: |            # 也可内联 PEM，但推荐走文件挂载，不要贴进 git 管理的库
    # 微信支付公钥模式（2024 年起新进件商户只下发公钥，不再签发平台证书）：
    # 配 wechatpay_public_key_id + 公钥来源之一（path 或 pem）即启用公钥验签。
    wechatpay_public_key_id: ""         # 微信支付公钥 ID（非密钥）
    wechatpay_public_key_path: ""       # 【文件挂载】微信支付公钥文件路径

  # 支付宝。enabled=true 时 app_id / 应用私钥（private_key 或 path）/ 证书或支付宝公钥 为【必填】。
  alipay:
    enabled: false
    app_id: ""                          # 支付宝应用 AppID（非密钥）
    private_key: ""                     # 【密钥】应用私钥（单行 base64）；若是多行 PEM 改用下方 path
    private_key_path: ""                # 【文件挂载】应用私钥文件路径（与 private_key 二选一）
    is_production: false                # 是否生产环境网关
    # 证书模式（与下方 alipay_public_key 二选一）——证书类一律走【文件挂载】：
    app_cert_public_key_path: ""        # 【文件挂载】应用公钥证书路径
    alipay_root_cert_path: ""           # 【文件挂载】支付宝根证书路径
    alipay_cert_public_key_path: ""     # 【文件挂载】支付宝公钥证书路径
    alipay_public_key: ""               # 支付宝公钥（公钥模式，非密钥；与证书模式二选一）

# ---------------------------------------------------------------------------
# LLM 大模型
# ---------------------------------------------------------------------------
llm:
  # providers 按优先级从高到低排列；每家的 models 同样按优先级从高到低。
  # 深度优先故障转移：同一家的模型全部失败后，才切换到下一家。
  providers:
    - name: qianfan                # 供应商标识
      api_key: ""                  # 【密钥】该供应商的 API Key
      models:                      # 该供应商可用模型列表（按优先级）
        - model-a
  system_prompt: ""                # 全局 system prompt
  timeout_seconds: 30              # 单次请求超时（秒）
  session_ttl_seconds: 3600        # 会话上下文在 Redis 的存活时间（秒）
  max_history_messages: 20         # 携带的历史消息条数上限
  max_message_chars: 2000          # 单条消息字符数上限
  redis_db: 1                      # LLM 会话使用的 Redis db 编号



# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
jwt:
  # Ed25519 签名用 PEM 密钥对（非对称，无共享 secret）。留空则用下面的默认路径。
  private_key_path: "config/pem/jwtpri.pem"   # 私钥 PEM 路径
  public_key_path: "config/pem/jwtpub.pem"    # 公钥 PEM 路径
  token_ttl_hours: 720                        # token 有效期（小时），默认 720=30 天
  # 旧 Laravel（tymon/jwt-auth）存量 token 的过渡期兼容验证：只验不签。
  # Ed25519 主验证失败时按此配置回退验 HS 签名；enabled=true 时 secret 为【必填】。
  # Laravel 下线且存量 token 全部过期后，整块删除并同步移除代码中的兼容层。
  legacy_laravel:
    enabled: false                            # 是否启用回退验证
    algorithm: "hs256"                        # hs256 | hs384 | hs512，留空按 hs256
    secret: ""                                # 【密钥】Laravel 的 JWT_SECRET

# ---------------------------------------------------------------------------
# SSL（如需应用层直接持有证书时使用，通常由前置网关终止 TLS）
# ---------------------------------------------------------------------------
ssl:
  key: ""                          # 【文件挂载】私钥文件路径
  pem: ""                          # 【文件挂载】证书文件路径

# ---------------------------------------------------------------------------
# 资讯（news）
# ---------------------------------------------------------------------------
news:
  fsurl: ""                        # 资讯源地址
  appid: ""                        # 资讯应用 ID（非密钥）
  appsecret: ""                    # 【密钥】资讯应用密钥

# ---------------------------------------------------------------------------
# 阿里云短信
# 注意：这里是【扁平 key】（sms_access_id 等直接挂在 aliyun 下），不是嵌套的 sms: 块。
# sms.enabled=true 时，sms_access_id / sms_access_secret / sms_sign_name /
# sms_template_code 均为【必填】。
# ---------------------------------------------------------------------------
aliyun:
  sms_access_id: ""                # 【密钥】AccessKey ID
  sms_access_secret: ""            # 【密钥】AccessKey Secret
  sms_sign_name: ""                # 短信签名（非密钥）
  sms_template_code: ""            # 短信模板 code（非密钥）

# ---------------------------------------------------------------------------
# 百度语音
# ---------------------------------------------------------------------------
baidu:
  voice:
    appid: ""                      # 应用 ID（非密钥）
    apikey: ""                     # 【密钥】API Key
    secretkey: ""                  # 【密钥】Secret Key

# ---------------------------------------------------------------------------
# 跨域
# ---------------------------------------------------------------------------
cors:
  allowed_origins: []              # 允许的来源列表，空表示按代码默认策略

# ---------------------------------------------------------------------------
# pprof 性能剖析（默认关闭，仅排查性能问题时临时开启）
# 端点与业务服务物理隔离、绑独立端口；线上务必保持 host=127.0.0.1，通过 SSH 端口转发访问。
# ---------------------------------------------------------------------------
pprof:
  enabled: false                   # 是否启动独立 pprof 端点
  host: 127.0.0.1                  # 监听地址，强烈建议保持 127.0.0.1
  port: "6060"                     # 监听端口
  block_profile_rate: 0            # block profile 采样率（每 N 纳秒阻塞采样一次），0=关闭；排查典型值 10000
  mutex_profile_fraction: 0        # mutex profile 采样比例（1/N），0=关闭；排查典型值 100
