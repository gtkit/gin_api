# ============================================================================
# config/env.yml.example —— 运行配置模板（唯一进 git 的参照文件）
# ============================================================================
#
# 用法：
#   cp config/env.yml.example config/env/env.yml   # 复制后按本机/本环境填写真实值
#
# 重要约定：
#   1. config/env/env.yml 不进 git（见 .gitignore），由开发本机、
#      测试服、生产服各自维护一份；本模板进 git，仅供参照、不含任何真实密钥。
#   2. 标【密钥】的字段：真实值只写进各机自己的 config/env.yml，本模板一律留空。
#   3. 标【文件挂载】的字段：值是磁盘文件路径，证书/多行 PEM 由部署单独提供文件，
#      不要把 PEM 内容直接贴进 yaml。
#   4. 标【必填】的字段：缺失或为空会导致 Validate 失败、进程启动即报错退出。
#   5. 每台机的 config/env.yml 只放该环境自己的配置，绝不混入其它环境的密钥。
#
# 用环境变量注入密钥（容器 / K8s 部署推荐）：
#   本文件读取完成后，会再加载 APP_ 前缀的环境变量覆盖同名配置键。
#   **双下划线表示层级，单下划线是键名自身的一部分**：
#
#     APP_DATABASE__PASSWORD          -> database.password
#     APP_DATABASE__MIGRATE_PASSWORD  -> database.migrate_password
#     APP_REDIS__PASSWORD             -> redis.password
#     APP_EMAIL__PASS                 -> email.pass
#     APP_SMS__ACCESS_SECRET          -> sms.access_secret
#     APP_RATELIMIT__KEY_HMAC_SECRET  -> ratelimit.key_hmac_secret
#
#   这样密钥字段可以在本文件里留空，真实值只存在于 Secret / 环境变量中。
#
#   APP_ 是本服务独占的命名空间：以它开头却对应不上任何配置键的变量会让启动失败。
#   这是刻意的——拼错的密钥变量若被忽略，服务会带着这里的空值正常起来，
#   直到第一次用到该密钥才报错，而那条错误指不回真正的原因。
#   例外是 APP_ROOT（项目根目录，部署脚本在用），它不参与配置覆盖。
# ----------------------------------------------------------------------------

# 【必填】运行环境标识，取值 dev | test | prod。
# 决定路由版本化、日志中的环境名、以及代码里的 IsDev()/IsTest()/IsProd() 判定。
env: dev

# ---------------------------------------------------------------------------
# 应用 / HTTP 服务
# ---------------------------------------------------------------------------
application:
  domain: "https://example.com"   # 站点对外访问域名（用于拼接回调地址等）
  host: 0.0.0.0                    # 【必填】监听地址：本地可用 localhost，线上用 0.0.0.0
  ishttps: false                   # 是否以 HTTPS 对外（一般由前置网关终止 TLS，这里多为 false）
  name: app_client                 # 【必填】应用名，用于日志与运行标识
  port: "8008"                     # 【必填】HTTP 监听端口，字符串形式
  # 读超时分两段，分别控制不同的攻击面：
  #   read_header_timeout 只管读请求头，挡的是连上来不发完头的连接；
  #   read_timeout       管读完整个请求（头 + 体），挡的是慢 body。
  # 合成一个键时，只有前者受控而后者用固定默认值——配置里的数字会严重低估暴露面。
  read_header_timeout: 10          # 读请求头上限（秒），0 用内置默认
  read_timeout: 60                 # 读整个请求上限（秒），0 用内置默认
  timezone: "Asia/Shanghai"        # 【必填】时区，须为合法 IANA 时区名
  # 优雅关停时「/ready 翻成 503」到「关闭 HTTP 监听」之间的等待秒数。
  # 等的是负载均衡器的传播延迟：本实例已宣告不再就绪，但 LB 还需一个探测周期
  # 才会把它摘出转发目标。取值应不小于 LB 的探测间隔；<=0 时兜底 5 秒。
  drain_wait_seconds: 5
  # 全局请求体字节上限（兜底 404/405 等不进任何路由组的路径）。
  # <=0 用内置默认 10MB；路由级上限只能比它更严（见 docs/api-conventions.md）。
  max_body_bytes: 0

# ---------------------------------------------------------------------------
# 数据库（MySQL）
# ---------------------------------------------------------------------------
database:
  dbtype: mysql                    # 数据库类型标识；必填且无默认值，只接受精确 mysql，不接受其他类型、大小写变体或首尾空白
  host: 127.0.0.1                  # 【必填】数据库地址
  port: "3306"                     # 【必填】数据库端口
  name: sleep                      # 【必填】库名
  username: root                   # 【必填】服务运行使用的用户名；推荐只授 DML 权限
  password: ""                     # 【密钥】数据库密码
  # 迁移专用凭据（可选）。启用开关是**非空的 migrate_username**：
  #   * 只填 migrate_password 而不填 migrate_username → 启动期校验失败（非法组合，
  #     静默回退会让人误以为迁移在用独立账号）。
  #   * 两者都不填 → 迁移回退使用上面的运行凭据，并打印一条不含凭据的告警。
  # 推荐做法：运行账号只授 DML，DDL 只授这里的迁移账号，避免运行期账号长期持有 DDL 权限。
  # migrate_password 允许为空（Socket 认证等受控场景）。
  migrate_username: ""             # 迁移专用用户名（留空 = 不启用）
  migrate_password: ""             # 【密钥】迁移专用密码（允许为空）
  # 连接池沿用 Effective* 规则：省略/0 取默认，负值拒绝；显式正数 idle 不得超过显式正数 open。
  maxopenconn: 25                  # 最大打开连接数；省略/0=默认 25，不表示无限；必须非负
  maxidleconn: 10                  # 最大空闲连接数；省略/0=默认 10，并钳制到生效的打开上限；必须非负
  maxlifeseconds: 1800             # 连接最大存活时间（秒）；省略/0=默认 1800，正数按配置使用，负值拒绝
  maxidletimeseconds: 300          # 空闲连接最长存活时间（秒）；0/留空=默认 300
                                   # 不要设成"无限"：数据库侧单方面断开的连接会一直留在池里，
                                   # 直到某次真实请求才发现它已死。
  # 连接与迁移共用的字符集/collation 单一来源；不依赖数据库环境默认值——
  # 同一份 SQL 在不同默认 collation 的实例上，比较与排序结果会不同。
  charset: utf8mb4                 # 留空=默认 utf8mb4
  collation: utf8mb4_unicode_ci    # 留空=默认 utf8mb4_unicode_ci
  # 受支持的最低 MySQL 版本。它同时用于跳过 GORM 的版本探测与启动期实测校验：
  # 真实版本低于此值、或数据库是 MariaDB/未知 vendor，启动即失败。
  min_version: "8.0"               # 留空=默认 8.0

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
redis:
  addr: 127.0.0.1:6379             # Redis 地址 host:port；无默认值，无 Redis 消费能力时可留空，启用相关能力时必填
  password: ""                     # 【密钥】Redis 密码（无密码留空）
  # 使用的 db 编号列表；配置地址时必填，无地址且无消费者时可留空；不得重复、不得为负。
  #
  # 【库 0 必须在列表里】下面两项能力在装配处固定取 db 0，启用任一项时校验会要求它：
  #   - 任一 ratelimit 策略用 store: redis
  #   - auth.mode: local（刷新令牌与撤销记录）
  # 缺少消费者所需 DB 是配置错误，启动校验会拒绝；不能当作暂时不可达放行。
  # cache.redis_db 与 tasks.redis_db 走各自的配置项，同样必须出现在本列表里。
  dbs: [0, 1, 2]
  # 仅可降级能力启用时，首次连接失败保留 Owner，tracing 就绪后开始恢复：
  # 首次/失败后等待 5s，每次使用 10s context 预算；实际返回还受上述客户端 I/O 超时约束。
  # 首次成功后停止构造重试，沿用同一客户端；已挂载缓存和限流在各自恢复条件满足后重新使用 Redis。
  # local 认证、redis + fail_closed 限流或任务队列仍要求启动时可用；未配置时不启动恢复。
  # 认证撤销/刷新、限流与响应缓存共用的key前缀。空串/省略原样回落application.name；
  # 非空值原样使用，不补冒号，不能仅含空白。存量升级须保留原实际namespace：
  # 旧版未消费此字段，若已填且不同于旧application.name，升级前先改成原namespace，
  # 避免撤销/刷新状态失联。切换namespace需单独停流及重新认证方案，不自动搬迁key。
  prefix: ""
  # 连接池与超时：全部可留空（0 = 采用 redisx 自身默认值）。
  # 填了就必须自洽——min_idle_conns 不得大于 pool_size，否则连接池永远补不到
  # 空闲目标，表现为持续的建连尝试。启动时即校验。
  pool_size: 0                     # 每个 db 的最大连接数
  min_idle_conns: 0                # 最小空闲连接数，须 <= pool_size
  dial_timeout_ms: 0               # 建连超时（毫秒）
  read_timeout_ms: 0               # 单次读超时（毫秒）
  write_timeout_ms: 0              # 单次写超时（毫秒）


# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
log:
  level: info                      # 日志输出级别；必填且无配置默认值，拒绝纯空白；去首尾空白后只接受 debug/info/warn/error/dpanic/panic/fatal，大小写严格；prod禁止debug，dev/test允许
  path: ./logs/app_client          # 主日志路径；必填且无配置默认值，拒绝纯空白，消费时去首尾空白；生产绝对路径必须位于 APP_ROOT 下
  sql: 0                           # 是否逐条打印 SQL（1 开 0 关）；生产默认 0。
                                   # 无论开关：SQL 日志已在代码层强制参数化，错误/慢查询日志不落真实绑定参数。
  # SQL专属慢查询WARN阈值（整数毫秒）；省略/null=200ms，0仅关闭慢查询WARN，
  # 正数按配置生效，负数或超出time.Duration范围拒绝；不关闭SQL错误日志或sql非零时的普通INFO。
  sql_slow_threshold_ms: null
  compress: 1                      # 归档日志是否压缩（maxsize/maxage/maxbackups/compress 均实际生效）
  consolestdout: 1                 # 是否输出到控制台
  filestdout: 1                    # 是否输出到文件
  maxage: 30                       # 日志保留天数
  maxbackups: 30                   # 日志最大保留份数
  maxsize: 100                     # 单个日志文件大小上限（MB）
  # 访问日志是否记录请求体/响应体（默认 false）。开启即把用户提交的内容
  # 写进日志文件（有界捕获 + 敏感字段脱敏仍生效）——属隐私影响面，
  # 开启前确认合规口径。两个开关相互独立。
  access_request_body: false
  access_response_body: false


# ---------------------------------------------------------------------------
# 邮件出站通道（SMTP，经 gtkit/tools/mailx 发信）
# host 留空 = 不启用（不构造客户端）；启用时 from 为【必填】且须为合法地址。
# 默认 notification.mail 插件在 Init 构造客户端；host 与 alert_to 同时非空才参与 H 系列告警。
# alert_to 留空只禁用邮件告警，不取消已启用客户端；字段不齐会在配置/构造阶段报错。
# ---------------------------------------------------------------------------
email:
  host: ""                         # SMTP 主机；空禁用客户端，并要求其他 email 字段为空
  port: 0                          # 0 走库默认 25；587 提交口；465 需配 implicit_ssl: true
  user: ""                         # SMTP 账号；留空 = 不认证（仅可信内网中继）
  pass: ""                         # SMTP 密码/授权码【密钥】；与 user 配对使用，空则不提供密码
  from: ""                         # 发件地址；host 非空时必填合法地址，无默认值
  from_name: ""                    # 发件人显示名；空则不额外设置显示名
  implicit_ssl: false              # 465 端口式 SMTPS；默认策略为 STARTTLS 强制 TLS
  alert_to: []                     # 告警收件人合法地址列表；空不发邮件告警，非空要求 host

# ---------------------------------------------------------------------------
# 短信出站通道（当前支持 aliyun）
# 默认 notification.sms 在 Init 构造客户端；provider 空禁用并要求其他 SMS 字段为空。
# provider 仅 aliyun；启用时 access_id / access_secret / sign_name【必填】，无默认值。
# templates 是"逻辑模板名 → 供应商模板"映射，业务与告警都以逻辑名引用。
# alert_phones 与 alert_template 必须成对配置，成对即启用短信告警通道；
# 告警模板必须声明 ${env} 变量（发送参数固定为 {"env": 环境名}）。
# ---------------------------------------------------------------------------
sms:
  provider: ""                     # 仅 aliyun；空不构造客户端，替换实现不扩展此配置白名单
  access_id: ""                    # AccessKey ID【密钥】；provider 非空时必填，无默认值
  access_secret: ""                # AccessKey Secret【密钥】；provider 非空时必填，无默认值
  region_id: ""                    # 区域；留空走驱动默认 cn-hangzhou
  sign_name: ""                    # 必填默认签名；模板 sign_name 空时回落到此值
  templates: {}                    # 逻辑模板映射；空无模板，每项 code 必填、sign_name 空用全局签名
  alert_phones: []                 # 告警手机号列表；空不发短信告警，非空与 alert_template 成对
  alert_template: ""               # 告警逻辑名（非供应商 ID）；空不告警，非空须存在且接收 env 参数


# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
auth:
  # 【必填，无默认值】认证模式，只接受 local 或 external。
  #
  # 刻意不给默认值：默认成 local，打算接外部身份提供方的部署会平白多出一组
  # 无人看管的凭据端点；默认成 external，使用者会以为认证已就绪，而实际上
  # 没有任何签发入口——两种默认都会静默地给出一个错误的系统。
  #
  #   local    —— 本服务保管用户凭据，注册/登录/刷新/登出端点全部注册。
  #               需要可用的 redis：登出与刷新令牌轮换都依赖它做撤销，
  #               而"能登录、登不出"比没有认证更危险，因此缺 redis 直接启动失败。
  #   external —— 身份来自外部（IdP、网关、既有认证服务），本服务只验签与授权，
  #               不注册任何认证端点。claims 映射与用户同步的接线点见 SCAFFOLD.md。
  mode: ""

  # 密码哈希代价（bcrypt），留空按 12。下限 10：再低就快到可离线爆破。
  # 只对 local 模式有意义。
  bcrypt_cost: 12

  # 【密钥｜local 模式必填，>= 32 字节】刷新令牌重放材料的加密密钥。
  #
  # 它加密"轮换出的下一代刷新令牌"——那是可直接使用的凭据，明文落库时
  # 一次存储快照泄漏即可拼出当前有效的刷新令牌。**必须专用**，禁止复用
  # JWT / 限流 / 数据库或任何其他密钥。
  # 轮换语义：换密钥 = 当时处于重放窗口（10 秒）内的刷新失败一次，
  # 客户端重新登录即可；不触发令牌族撤销。
  refresh_replay_secret: ""

  # 刷新令牌寿命，必须长于访问令牌寿命（jwt.token_ttl_hours）——
  # 更短的话刷新令牌先过期，等于没有刷新机制，启动时会直接报错。
  #
  # 访问令牌寿命不在这里配：它由 jwt.token_ttl_hours 决定（签发令牌的是
  # JWT 装配）。在两处各配一个，客户端拿到的 expires_in 迟早会与令牌里
  # 真实的 exp 对不上。
  refresh_ttl: 720h                # 30 天；必须长于访问令牌寿命
  # 口令哈希校验的进程级并发上限，<=0 按 CPU 核数。bcrypt 是刻意昂贵的计算：
  # 限流约束的是单来源/单账号速率，约束不了聚合并发——一批分布式登录请求
  # 能把全部 CPU 吃光。超限的校验排队而不是拒绝。
  bcrypt_max_concurrent: 0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
jwt:
  # 当前验签密钥；local 模式同时用于签发。jwt generate 不传 out-dir 时仍读取本节的完整文件路径与 kid。
  # 生成命令从 APP_ROOT/config/env/env.yml 读取；APP_ROOT 未设置时基于当前工作目录，不按 bin 查找。
  # 相对密钥路径以该根目录为基准，绝对路径保持；两条路径均须非空、不同，父目录须已存在且非软链接。
  # 显式 --kid 优先；显式 --out-dir 须同时传 --kid，沿用 kid.private.pem/kid.public.pem 且无需 env。
  # 生成命令沿用 APP_JWT__ACTIVE__* 环境覆盖，生产 env 文件继续校验权限；任何已有目标均拒绝覆盖。
  # 旧密钥保留材料转换：./bin/gin_api jwt reencode --private-key <旧私钥> --public-key <旧公钥> --out-dir <新目录>。
  # 转换后只修改两条路径，保留原 kid、issuer/audiences、previous 和兼容截止时刻。
  # Ed25519：私钥为 PKCS#8（PRIVATE KEY），公钥为 PKIX（PUBLIC KEY）。
  # 公钥路径必填，无默认文件；私钥仅 local 模式必填。支持绝对路径或相对 APP_ROOT 的路径。
  active:
    # 写入 JWT header 的 key id；必填，匹配 [A-Za-z0-9._-]{1,64}，同 kid 不替换密钥材料。
    kid: ""                        # 匹配 [A-Za-z0-9._-]{1,64}
    # 签发私钥文件路径：local 必填，external 可留空且不加载；PKCS#8 PEM，权限 0600，不写入 YAML。
    private_key_path: ""           # 【文件挂载】0600
    # 验签公钥文件路径，两种模式均必填；PKIX PEM，local 必须与上述私钥配对。
    public_key_path: ""            # 【文件挂载】
  # 仅验签的旧密钥，默认 []，最多 8 把；kid 必须唯一，public_key_path 为 PKIX 公钥。
  # 轮换时生成新 kid，旧公钥保留至旧 token 全部过期，再从 previous 移除。
  previous: []
  # previous:
  #   - kid: k2025b
  #     public_key_path: config/pem/k2025b.public.pem
  # 签发与验签的 iss，必填且非空；必须与接受的令牌签发方一致。
  issuer: ""
  # 签发与验签的 aud，必填且至少一个非空受众；限定令牌可用的服务。
  audiences: []
  # 访问令牌寿命（小时），正值覆盖；0/留空/负值按 auth.mode 回落。
  # local 默认 1 小时，external 默认 720 小时；外部令牌实际寿命由其签发方决定。
  # 本地认证的独立刷新令牌寿命由 auth.refresh_ttl 控制，须长于访问令牌。
  token_ttl_hours: 0
  # 验签 exp/nbf 的时钟容差（秒），默认 0，范围 0–120。
  clock_skew_seconds: 0            # 允许的时钟偏移，上限 120
  # 验签结果缓存容量，默认 0 禁用，不得为负；条目最多保留至 token 过期。
  cache_max_entries: 0             # 验签结果缓存容量；0 = 禁用
  # 无 kid 的存量令牌接受截止时刻，RFC3339；默认空表示不接受，不随重启顺延。
  unkeyed_token_accept_until: ""
  # Laravel 存量令牌的独立 RFC3339 截止时刻；默认空表示不接受。
  laravel_accept_until: ""
  # Laravel 旧 token 仅验签兼容；须同时启用 enabled 并配置 laravel_accept_until。
  laravel:
    # 是否启用旧 Laravel 令牌验签，默认 false；不用于签发新令牌。
    enabled: false
    # 旧 Laravel HMAC 验签密钥；enabled=true 时必填，默认空，不用于 Ed25519。
    secret: ""                     # 【密钥】
    # 旧 Laravel HMAC 算法，默认 hs256；仅 hs256/hs384/hs512。
    algorithm: hs256

ssl:
  key: ""                          # 【文件挂载】私钥文件路径
  pem: ""                          # 【文件挂载】证书文件路径

# ---------------------------------------------------------------------------
# 资讯（news）
# ---------------------------------------------------------------------------
news:
  # 【告警 webhook】logger 的 H 系列告警发往这里。底层是 gtkit/msgbot，
  # 因此支持飞书 / 钉钉 / 企业微信三家，报文差异由它承担。
  # 字段名沿用历史（最初只支持飞书），语义已是"告警 webhook"，各平台通用。
  fsurl: ""                        # 默认 http(s) webhook；空跳过默认机器人发送，显式目标覆盖此值
  # 平台：feishu（留空即此值）、dingtalk、wecom。
  # 留空必须与本字段引入之前的行为一致——否则一次升级就会让存量部署的告警发不出去。
  platform: ""
  secret: ""                       # 加签密钥【密钥】；默认空，平台侧开启加签时必须提供
  appid: ""                        # 图片资讯应用 ID；默认空，不参与文本告警
  appsecret: ""                    # 图片资讯应用密钥【密钥】；默认空，不参与文本告警

# ---------------------------------------------------------------------------
# 跨域
# ---------------------------------------------------------------------------
cors:
  allowed_origins: []              # 允许的来源列表，空表示按代码默认策略

# ---------------------------------------------------------------------------
# pprof 性能剖析（默认关闭，仅排查性能问题时临时开启）
# 端点与业务服务物理隔离、绑独立端口；线上务必保持 host=127.0.0.1，通过 SSH 端口转发访问。
# ---------------------------------------------------------------------------
pprof:
  enabled: false                   # 是否启动独立 pprof 端点
  host: 127.0.0.1                  # 监听地址，强烈建议保持 127.0.0.1
  port: "6060"                     # 监听端口
  block_profile_rate: 0            # block profile 采样率（每 N 纳秒阻塞采样一次），0=关闭；排查典型值 10000
  mutex_profile_fraction: 0        # mutex profile 采样比例（1/N），0=关闭；排查典型值 100

# ---------------------------------------------------------------------------
# 可信代理 / 客户端 IP
#
# 【默认不信任任何代理】两个列表都留空时，客户端 IP 只取真实 TCP peer 地址，
# 请求里的 X-Forwarded-For / X-Real-IP 一律忽略。
#
# 为什么必须显式配置：框架默认信任所有代理，会直接采信这两个由客户端完全可控的 header——
# 任何人都能零成本把自己伪造成任意 IP，访问日志与业务审计里的 IP 因此不可信，
# 接上限流后攻击者轮换伪造 IP 即可无限绕过。
#
# 【部署在反向代理之后时必须配置】否则日志与审计记录到的会是代理自身的地址。
# 只填你确实控制的那一层代理网段，不要图省事写 0.0.0.0/0——生产环境会直接拒绝启动。
# ---------------------------------------------------------------------------
proxy:
  trusted_proxies: []              # 可信代理的 CIDR 或单个 IP；空=不信任任何代理
                                   # 例：["10.0.0.0/8"] 或 ["172.17.0.1"]
                                   # 生产禁止 0.0.0.0/0 与 ::/0（等价于回到不安全默认值）
  # 允许用于提取客户端 IP 的转发头；仅当请求来自可信代理时才采信。
  # 例：["X-Forwarded-For"]。**不配置 = 不从任何 header 取 IP**（取连接对端）。
  #
  # 【与 trusted_proxies 必须配套】配了 trusted_proxies 却留空本项 = 矛盾配置，启动失败：
  # trusted_proxies 的唯一用途就是决定"来自哪些对端时才采信转发头"，列了代理不列头，
  # 那份信任没有任何作用。静默接受的后果是代理后所有客户端共用一个限流桶
  # （IP 维度限流退化成全局限流），且审计里的来源 IP 全变成代理自己。
  remote_ip_headers: []


# ---------------------------------------------------------------------------
# 限流
# ---------------------------------------------------------------------------
# **母版强制应用层限流：业务路由硬引用下面的默认策略。**
#
# 因此 policies **不能清空**——清空会让路由引用无法解析，进程启动失败。
# 那是刻意的：脚手架无从判断你的入口有没有网关，而"配置写了策略 ID 却不生效"
# 比启动失败坏得多——后者立刻被发现，前者要等到被打穿才知道。
#
# 上游已有 API Gateway / WAF 承担限流时，正确做法是把这里的速率调高到只作为
# 兜底上限，而不是删掉策略或从路由上摘掉引用。
#
# 下面给出的是一份**可直接使用**的默认策略，覆盖两个最常见的维度：
# 按来源（挡住单 IP 的暴力冲击）与按身份（挡住单账号滥用）。
# 一条路由可以同时引用多条，由模块路由的 RateLimit 接线声明。
#
# 注意 store: local 的多副本语义：**有效限额 = 配置值 × 副本数**。
# 它适合"高位防护上限"，不适合精确业务限额（如"每账号每分钟 5 次登录"）——
# 后者必须用 store: redis。
# ─────────────────────────── 出站 HTTP 客户端 ───────────────────────────
# 【定位】按名字声明下游，装配期一次性建好并全进程复用；调用点只按名字取，
# 取不到就是编码或配置错误（不会隐式再建一个）。
#
# 【为什么不在调用点 new】每次 new 等于每次新建连接池：连接无法复用，高频调用下
# 本地端口会被 TIME_WAIT 占满；而且超时与响应体上限散落到每个调用点，漏一处就是
# 一个能把进程拖垮的洞。
#
# 【名字怎么取】按**故障域**取，与熔断器的下游名保持一致——两者用同一个名字，
# "这个下游的连接池"与"这个下游的熔断器"才指的是同一件事。
#
# clients 为空即不启用，不构造任何客户端。母版不预设任何下游：
# 下游集合是每个项目自己的事实，预置一个假的只会被照抄。
outbound:
  # defaults 是各 client 未显式设置时继承的默认值；两级都未设时用内置兜底
  # （timeout 10s / max_response_bytes 8 MiB / max_conns_per_host 64 /
  #  max_idle_conns_per_host 16）。兜底是防漏，不是给每个下游的合理值。
  defaults:
    # 单次请求的总超时（含连接、写、读、重定向）。上限 5m——超过它的"超时"
    # 实际等于没有超时：入站请求的处理预算远小于这个量级，真等到它触发时
    # 请求早已被上游放弃。
    timeout: 10s
    # 响应体读取上限（字节）。下游返回了 HTML 错误页、或被中间设备劫持时，
    # 没有上限就会被整个读进内存——一次异常就够把进程打到 OOM。
    max_response_bytes: 8388608
    # 各 client 未显式给出 base_url 时继承的默认值；一般留空，按 client 各配。
    base_url: ""
    # 每主机连接上限与保留空闲连接数（后者 <= 前者，同一份配额里出）。
    # <=0 用内置兜底（64 / 16）。
    max_conns_per_host: 0
    max_idle_conns_per_host: 0
  clients: {}
  #  billing:
  #    # 必填：没有它，"这个名字对应哪个下游"只存在于调用点的字符串里，
  #    # 换环境时没有任何一处可改。
  #    base_url: https://billing.internal
  #    timeout: 3s
  #  inventory:
  #    base_url: https://inventory.internal
  #    # 每主机连接上限；每个名字独立池，一个下游的慢响应不会占用另一个的配额。
  #    max_conns_per_host: 32
  #    # 保留的空闲连接数，必须 <= max_conns_per_host（同一份配额里出）。
  #    max_idle_conns_per_host: 8
  # breaker 是全部下游共用的熔断阈值；实例按下游名各自独立（一个下游的故障
  # 只熔断它自己）。零值取保守默认，通常不用改。
  breaker:
    # 连续失败达到该值即熔断（0 取默认 5）。
    consecutive_failures: 0
    # 熔断后到半开探测的等待（0 取默认 60s，上限 10m）。
    open_timeout: 0s
    # 半开期放行的探测请求数（0 取默认 1）。
    half_open_max_requests: 0

# ─────────────────────────── GET 响应缓存 ───────────────────────────
# 【默认关闭，且这是有意的】响应缓存把一次响应的**字节**原样发给后续请求。
# 挂到带身份的路由上，就是把 A 的数据发给 B——不会报错、不会有异常日志，
# 只会在某天被用户发现。母版不替使用者打开它，也不提供"全局开启"这条路径。
#
# 【四道防线】开启后仍然只对**显式挂了中间件的路由**生效；挂上之后每个请求
# 还会再过一次身份判据（带 Authorization / App-Token / Cookie / Range 的一律
# 绕过缓存）；响应期再做一次准入——携带 Set-Cookie、Cache-Control
# private/no-store/no-cache 或 Vary 的响应不进缓存，命中回放前还会复检。
# 每道都必要——路由该不该缓存由模块决定，而人会看错。
#
# 【怎么用】模块 Deps 注入了 Cache 中间件工厂，在只读路由上显式挂：
#   g.GET("/hot", deps.Cache(0), handler.Hot)
cache:
  enabled: false
  # redis：跨副本共享，有界由 Redis 的 maxmemory 策略负责。
  # memory：单副本本地，必须配 max_bytes（下方），用有界的准入/淘汰。
  store: redis
  # redis 后端使用的逻辑库号，必须出现在 redis.dbs 里（资源层只打开声明过的库）。
  redis_db: 0
  # 默认缓存时长；上限 10m——再长就不是缓存而是一份副本：数据源变更后
  # 用户会在很长时间里看到旧值，而没有任何一处会提示这件事正在发生。
  ttl: 30s
  # 可缓存响应体的上限（字节）。缓存大响应挤占的是给热点小响应的容量，
  # 命中率反而更差。
  max_body_bytes: 1048576
  # 仅 memory 后端使用：本地缓存总容量上限（字节），必须为正。
  # 无界的本地缓存在键空间随请求变化时会一直涨——那不是命中率问题，
  # 是一次必然发生的 OOM。
  max_bytes: 67108864

# ─────────────────────────── OpenTelemetry 导出 ───────────────────────────
# 【默认关闭，但埋点始终在】关闭时进程沿用 OTel 的全局 no-op provider：
# 所有记录点仍在，每次记录都是空操作。埋点不随开关增减是有意的——
# 把埋点也做成条件的，打开导出那天才会发现某条关键路径压根没埋，
# 而那一天通常正是出事要查的时候。
telemetry:
  enabled: false
  # OTLP/HTTP 收集端地址（不带 scheme）。启用时必填：没有它，导出会在后台
  # 持续失败而进程看起来一切正常。
  endpoint: "otel-collector:4318"
  # 明文 HTTP。仅限收集端在同一内网或以边车形式运行时使用。
  insecure: true
  # 两类信号分别开关；都关掉等于建了一个什么都不导出的 exporter，配置校验会拒绝。
  metrics: true
  traces: true
  # trace 采样率 (0,1]。采样器是 ParentBased 包住比例采样：上游已决定采样的
  # 链路整条留下，否则调用链会在本服务断掉——而那恰恰是最需要看的那种。
  sample_ratio: 0.1
  # 指标导出周期。更短会让收集端与网络承担与信息量不相称的开销：
  # 指标本来就是聚合值，30s 的分辨率对告警与容量判断都够用。
  export_interval: 30s
  # 关停时 flush 的预算，上限 30s。它挤占的是优雅关停的总预算——
  # 遥测丢一点可以接受，因为关停而超时的连接不可以。
  shutdown_timeout: 5s
  # 导出请求附带的头（租户标识、鉴权令牌等）。
  headers: {}

# TASKQUEUE-BEGIN：可选队列默认未接线；启用步骤见 internal/taskqueue/README.md。
# 启用时移除本块下面各行最前面的 "# "，保留原本的 YAML 注释。
# tasks:
#   enabled: false
#   concurrency: 10
#   queues:
#     default: 1
#   task_timeout: 5m
#   shutdown_timeout: 25s
#   # 必须包含在 redis.dbs 中；资源层只打开声明过的库。
#   redis_db: 0
#   scheduler:
#     enabled: false
# TASKQUEUE-END

ratelimit:
  # 【密钥】限流键里主体标识（IP / userID）的 HMAC 密钥，>= 32 字节。
  # **必须专用**，禁止复用 JWT / 数据库 / 任何其他业务密钥。
  # 轮换语义：换密钥 = 所有桶重算 = 一次性限额重置（不做双密钥灰度）。
  key_hmac_secret: ""
  policies:
    # 每项 rate（每秒补充量）和 burst（突发容量）必填且为正，无默认额度。
    # store=redis 时，按定点速率补满 burst 的向上取整秒数 + 60s 不得超过 24h，否则启动失败。
    # 按来源的高位防护：挡住单个 IP 的高频冲击。
    # store: local 因此不需要 Redis 就能生效——多副本下实际阈值是 20 × 副本数，
    # 作为"高位上限"这个放大可以接受；要精确就改 redis。
    - id: default.ip
      rate: 5                    # 每秒补 5 个
      burst: 20                  # 允许 20 的突发
      scope: ip
      store: local
      failure_mode: fail_closed  # 本地桶不会不可用，此处仅为显式声明
      max_keys: 100000           # 达上限拒绝新建，不淘汰活跃桶
    # 按身份的配额：只能挂在需鉴权的路由上（拿不到身份就退化成共享桶）。
    # 配置了 Redis 时把 store 改成 redis，可获得跨副本的精确限额。
    - id: default.user
      rate: 10
      burst: 50
      scope: user
      store: local
      failure_mode: fail_closed
      max_keys: 100000
    # 认证凭据端点（注册/登录）的专用额度。
    #
    # 【auth.mode: local 时必需】这几条是全站唯一接受口令猜测的入口，
    # 与读接口共用一个额度等于给爆破留出与正常浏览同样宽的通道。
    #
    # 只按来源限、不按身份：请求发生在拿到身份**之前**，此时没有可用的
    # 用户维度——按身份限流对未登录的爆破者不起任何作用。
    #
    # rate 0.2 = 每 5 秒补 1 个，burst 10 允许正常用户连续几次输错。
    # **配了 Redis 就把 store 改成 redis**：local 的实际阈值是配置值 ×
    # 副本数，副本一多，防爆破的额度就跟着放大了。
    # 认证三条策略默认 **redis + fail_closed**：local 认证已强制依赖 Redis
    # （撤销表与刷新令牌都在上面），因此这里用 local store 只会带来
    # "有效阈值 = 配置值 × 副本数"的放大，而防爆破的额度最不该被放大。
    - id: auth.credential
      rate: 0.2
      burst: 10
      scope: ip
      store: redis
      failure_mode: fail_closed
      max_keys: 100000
    # 令牌端点（刷新/登出）的额度，可以宽一些：它们要求持有一个已签发的
    # 有效令牌，不构成口令猜测面。
    - id: auth.token
      rate: 1
      burst: 20
      scope: ip
      store: redis
      failure_mode: fail_closed
      max_keys: 100000
    # 凭据端点的**账号维度**额度（auth.credential 按来源，这条按被尝试的账号）。
    #
    # 两个维度互补：换 IP 即可绕过来源限流，账号维度让"同一账号的尝试频率"
    # 独立受限，挡住分布式口令喷洒。账号标识经 HMAC 派生进键，明文不进 Redis。
    # 该策略**不挂路由**，由认证模块在凭据校验之前直接判定；删掉这条即关闭
    # 账号维度（启动时会有一条 Warn 提示）。
    # 多副本部署把 store 改成 redis：local 的实际阈值是配置值 × 副本数。
    - id: auth.credential.account
      rate: 0.1                  # 每 10 秒补 1 次尝试
      burst: 5                   # 允许正常用户连续几次输错
      scope: user
      store: redis
      failure_mode: fail_closed
      max_keys: 100000
