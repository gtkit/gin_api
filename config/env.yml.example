# ============================================================================
# config/env.yml.example —— 运行配置模板（唯一进 git 的参照文件）
# ============================================================================
#
# 用法：
#   cp config/env.yml.example config/env/env.yml   # 复制后按本机/本环境填写真实值
#
# 重要约定：
#   1. config/env/env.yml 不进 git（见 .gitignore），由开发本机、
#      测试服、生产服各自维护一份；本模板进 git，仅供参照、不含任何真实密钥。
#   2. 标【密钥】的字段：真实值只写进各机自己的 config/env.yml，本模板一律留空。
#   3. 标【文件挂载】的字段：值是磁盘文件路径，证书/多行 PEM 由部署单独提供文件，
#      不要把 PEM 内容直接贴进 yaml。
#   4. 标【必填】的字段：缺失或为空会导致 Validate 失败、进程启动即报错退出。
#   5. 每台机的 config/env.yml 只放该环境自己的配置，绝不混入其它环境的密钥。
# ----------------------------------------------------------------------------

# 【必填】运行环境标识，取值 dev | test | prod。
# 决定路由版本化、日志中的环境名、以及代码里的 IsDev()/IsTest()/IsProd() 判定。
env: dev

# ---------------------------------------------------------------------------
# 应用 / HTTP 服务
# ---------------------------------------------------------------------------
application:
  domain: "https://example.com"   # 站点对外访问域名（用于拼接回调地址等）
  host: 0.0.0.0                    # 【必填】监听地址：本地可用 localhost，线上用 0.0.0.0
  ishttps: false                   # 是否以 HTTPS 对外（一般由前置网关终止 TLS，这里多为 false）
  name: app_client                 # 【必填】应用名，用于日志与运行标识
  port: "8008"                     # 【必填】HTTP 监听端口，字符串形式
  # 读超时分两段，分别控制不同的攻击面：
  #   read_header_timeout 只管读请求头，挡的是连上来不发完头的连接；
  #   read_timeout       管读完整个请求（头 + 体），挡的是慢 body。
  # 合成一个键时，只有前者受控而后者用固定默认值——配置里的数字会严重低估暴露面。
  read_header_timeout: 10          # 读请求头上限（秒），0 用内置默认
  read_timeout: 60                 # 读整个请求上限（秒），0 用内置默认
  timezone: "Asia/Shanghai"        # 【必填】时区，须为合法 IANA 时区名
  # 优雅关停时「/ready 翻成 503」到「关闭 HTTP 监听」之间的等待秒数。
  # 等的是负载均衡器的传播延迟：本实例已宣告不再就绪，但 LB 还需一个探测周期
  # 才会把它摘出转发目标。取值应不小于 LB 的探测间隔；<=0 时兜底 5 秒。
  drain_wait_seconds: 5

# ---------------------------------------------------------------------------
# 数据库（MySQL）
# ---------------------------------------------------------------------------
database:
  dbtype: mysql                    # 【必填】数据库类型，当前为 mysql
  host: 127.0.0.1                  # 【必填】数据库地址
  port: "3306"                     # 【必填】数据库端口
  name: sleep                      # 【必填】库名
  username: root                   # 【必填】服务运行使用的用户名；推荐只授 DML 权限
  password: ""                     # 【密钥】数据库密码
  # 迁移专用凭据（可选）。启用开关是**非空的 migrate_username**：
  #   * 只填 migrate_password 而不填 migrate_username → 启动期校验失败（非法组合，
  #     静默回退会让人误以为迁移在用独立账号）。
  #   * 两者都不填 → 迁移回退使用上面的运行凭据，并打印一条不含凭据的告警。
  # 推荐做法：运行账号只授 DML，DDL 只授这里的迁移账号，避免运行期账号长期持有 DDL 权限。
  # migrate_password 允许为空（Socket 认证等受控场景）。
  migrate_username: ""             # 迁移专用用户名（留空 = 不启用）
  migrate_password: ""             # 【密钥】迁移专用密码（允许为空）
  # 连接池。留空走默认值；显式写负数或 maxidleconn > maxopenconn 会在启动期被拒绝。
  # 注意：此前模板里的 maxidleconn(50) > maxopenconn(25) 是错的——底层会静默把空闲上限
  # 压到打开上限，配置写的与实际生效的不一致且无人告知，现已修正并加了启动期校验。
  maxopenconn: 25                  # 连接池最大打开连接数（0/留空=默认 25；不要设 0，底层含义是无限连接）
  maxidleconn: 10                  # 连接池最大空闲连接数（必须 <= maxopenconn）
  maxlifeseconds: 1800             # 连接最大存活时间（秒）；0/留空=默认 1800
  maxidletimeseconds: 300          # 空闲连接最长存活时间（秒）；0/留空=默认 300
                                   # 不要设成"无限"：数据库侧单方面断开的连接会一直留在池里，
                                   # 直到某次真实请求才发现它已死。
  # 连接与迁移共用的字符集/collation 单一来源；不依赖数据库环境默认值——
  # 同一份 SQL 在不同默认 collation 的实例上，比较与排序结果会不同。
  charset: utf8mb4                 # 留空=默认 utf8mb4
  collation: utf8mb4_unicode_ci    # 留空=默认 utf8mb4_unicode_ci
  # 受支持的最低 MySQL 版本。它同时用于跳过 GORM 的版本探测与启动期实测校验：
  # 真实版本低于此值、或数据库是 MariaDB/未知 vendor，启动即失败。
  min_version: "8.0"               # 留空=默认 8.0

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
redis:
  addr: 127.0.0.1:6379             # 【必填】Redis 地址 host:port
  password: ""                     # 【密钥】Redis 密码（无密码留空）
  dbs: [0, 1, 2]                   # 【必填】使用的 db 编号列表；不得重复、不得为负
  prefix: ""                       # key 统一前缀（可选）
  # 连接池与超时：全部可留空（0 = 采用 redisx 自身默认值）。
  # 填了就必须自洽——min_idle_conns 不得大于 pool_size，否则连接池永远补不到
  # 空闲目标，表现为持续的建连尝试。启动时即校验。
  pool_size: 0                     # 每个 db 的最大连接数
  min_idle_conns: 0                # 最小空闲连接数，须 <= pool_size
  dial_timeout_ms: 0               # 建连超时（毫秒）
  read_timeout_ms: 0               # 单次读超时（毫秒）
  write_timeout_ms: 0              # 单次写超时（毫秒）


# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
log:
  level: info                      # 【必填】日志级别：debug / info / warn / error
  path: ./logs/app_client          # 【必填】常规日志路径；生产绝对路径必须位于 APP_ROOT 下
  sql: 0                           # 是否逐条打印 SQL（1 开 0 关）；生产默认 0。
                                   # 无论开关：SQL 日志已在代码层强制参数化，错误/慢查询日志不落真实绑定参数。
  compress: 1                      # 归档日志是否压缩（maxsize/maxage/maxbackups/compress 均实际生效）
  consolestdout: 1                 # 是否输出到控制台
  filestdout: 1                    # 是否输出到文件
  maxage: 30                       # 日志保留天数
  maxbackups: 30                   # 日志最大保留份数
  maxsize: 100                     # 单个日志文件大小上限（MB）


# ---------------------------------------------------------------------------
# 邮件（SMTP，经 gtkit/tools/mailx 发信；host 留空 = 不启用，启动时跳过装配）
# ---------------------------------------------------------------------------
email:
  alias: ""                        # 发件人显示别名
  host: ""                         # SMTP 服务器地址；留空则不装配邮件客户端
  user: ""                         # SMTP 账号，同时作为发件人地址（须为合法邮箱）
  pass: ""                         # 【密钥】SMTP 密码 / 授权码
  port: 465                        # SMTP 端口；465 自动走隐式 SSL，其余端口强制 STARTTLS

# ---------------------------------------------------------------------------
# 短信验证码
# ---------------------------------------------------------------------------
sms:
  enabled: false                   # 是否启用短信；为 true 时下方 aliyun.sms_* 变为【必填】
  send_limit_enabled: false        # 是否开启 60 秒发送频控（生产建议 true）
  delete_code_on_verify: false     # 验证成功后是否立即作废 code 防重放（生产建议 true）
  allow_test_codes: false          # 是否允许测试白名单手机号用固定测试码（仅联调用）
  test_phones: []                  # 测试白名单手机号列表
  test_code: ""                    # 测试固定验证码
  code_ttl_seconds: 300            # 验证码有效期（秒）
  max_verify_attempts: 5           # 单个验证码最大校验尝试次数

# ---------------------------------------------------------------------------
# 支付
# ---------------------------------------------------------------------------
pay:
  # 微信支付 V3。enabled=true 时 app_id / mch_id / mch_cert_serial_number /
  # mch_apiv3_key 及商户私钥（path 或 pem 二选一）均为【必填】。
  wechat:
    enabled: false
    app_id: ""                          # 公众号/小程序 AppID（非密钥）
    mch_id: ""                          # 商户号（非密钥）
    mch_cert_serial_number: ""          # 商户证书序列号（非密钥）
    mch_apiv3_key: ""                   # 【密钥】APIv3 密钥
    mch_private_key_path: ""            # 【文件挂载】商户私钥文件路径（与下方 PEM 二选一）
    # mch_private_key_pem: |            # 也可内联 PEM，但推荐走文件挂载，不要贴进 git 管理的库
    # 微信支付公钥模式（2024 年起新进件商户只下发公钥，不再签发平台证书）：
    # 配 wechatpay_public_key_id + 公钥来源之一（path 或 pem）即启用公钥验签。
    wechatpay_public_key_id: ""         # 微信支付公钥 ID（非密钥）
    wechatpay_public_key_path: ""       # 【文件挂载】微信支付公钥文件路径

  # 支付宝。enabled=true 时 app_id / 应用私钥（private_key 或 path）/ 证书或支付宝公钥 为【必填】。
  alipay:
    enabled: false
    app_id: ""                          # 支付宝应用 AppID（非密钥）
    private_key: ""                     # 【密钥】应用私钥（单行 base64）；若是多行 PEM 改用下方 path
    private_key_path: ""                # 【文件挂载】应用私钥文件路径（与 private_key 二选一）
    is_production: false                # 是否生产环境网关
    # 证书模式（与下方 alipay_public_key 二选一）——证书类一律走【文件挂载】：
    app_cert_public_key_path: ""        # 【文件挂载】应用公钥证书路径
    alipay_root_cert_path: ""           # 【文件挂载】支付宝根证书路径
    alipay_cert_public_key_path: ""     # 【文件挂载】支付宝公钥证书路径
    alipay_public_key: ""               # 支付宝公钥（公钥模式，非密钥；与证书模式二选一）

# ---------------------------------------------------------------------------
# LLM 大模型
# ---------------------------------------------------------------------------
llm:
  # providers 按优先级从高到低排列；每家的 models 同样按优先级从高到低。
  # 深度优先故障转移：同一家的模型全部失败后，才切换到下一家。
  providers:
    - name: qianfan                # 供应商标识
      api_key: ""                  # 【密钥】该供应商的 API Key
      models:                      # 该供应商可用模型列表（按优先级）
        - model-a
  system_prompt: ""                # 全局 system prompt
  timeout_seconds: 30              # 单次请求超时（秒）
  session_ttl_seconds: 3600        # 会话上下文在 Redis 的存活时间（秒）
  max_history_messages: 20         # 携带的历史消息条数上限
  max_message_chars: 2000          # 单条消息字符数上限
  redis_db: 1                      # LLM 会话使用的 Redis db 编号



# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
auth:
  # 【必填，无默认值】认证模式，只接受 local 或 external。
  #
  # 刻意不给默认值：默认成 local，打算接外部身份提供方的部署会平白多出一组
  # 无人看管的凭据端点；默认成 external，使用者会以为认证已就绪，而实际上
  # 没有任何签发入口——两种默认都会静默地给出一个错误的系统。
  #
  #   local    —— 本服务保管用户凭据，注册/登录/刷新/登出端点全部注册。
  #               需要可用的 redis：登出与刷新令牌轮换都依赖它做撤销，
  #               而"能登录、登不出"比没有认证更危险，因此缺 redis 直接启动失败。
  #   external —— 身份来自外部（IdP、网关、既有认证服务），本服务只验签与授权，
  #               不注册任何认证端点。claims 映射与用户同步的接线点见 SCAFFOLD.md。
  mode: ""

  # 密码哈希代价（bcrypt），留空按 12。下限 10：再低就快到可离线爆破。
  # 只对 local 模式有意义。
  bcrypt_cost: 12

  # 刷新令牌寿命，必须长于访问令牌寿命（jwt.token_ttl_hours）——
  # 更短的话刷新令牌先过期，等于没有刷新机制，启动时会直接报错。
  #
  # 访问令牌寿命不在这里配：它由 jwt.token_ttl_hours 决定（签发令牌的是
  # JWT 装配）。在两处各配一个，客户端拿到的 expires_in 迟早会与令牌里
  # 真实的 exp 对不上。
  refresh_ttl: 2160h

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
jwt:
  # 【必填】当前签发用的密钥。用 `go run . jwt generate --kid <kid>` 生成。
  #
  # kid 稳定标识**一组不可变的密钥材料**：轮换 = 生成新 kid，把旧公钥移入
  # previous，而不是原地替换同一个 kid 的文件。
  active:
    kid: ""                        # 匹配 [A-Za-z0-9._-]{1,64}
    private_key_path: ""           # 【文件挂载】0600
    public_key_path: ""            # 【文件挂载】
  # 已退役但仍需验签的公钥，最多 8 个（只放公钥，不放私钥）。
  #
  # 重叠窗口必须覆盖旧令牌的剩余 TTL，否则轮换仍会造成批量失效。
  previous: []
  # previous:
  #   - kid: k2025b
  #     public_key_path: config/pem/k2025b.public.pem
  #
  # 【必填】令牌作用域。缺了它们，一个服务的令牌可以被重放到共享密钥的另一个服务上。
  issuer: ""
  audiences: []
  token_ttl_hours: 720             # 30 天；改动会影响存量客户端的重登频率
  clock_skew_seconds: 0            # 允许的时钟偏移，上限 120
  cache_max_entries: 0             # 验签结果缓存容量；0 = 禁用
  # 无 kid 存量令牌的**绝对** RFC3339 截止时刻。空 = 不接受。
  #
  # 用绝对时刻而不是时长：时长会让每次重启自动顺延，兼容口因此变成永久的。
  # 取值应为「切换时刻 + 旧令牌最大 TTL」，迁移完成后**删除该配置**。
  unkeyed_token_accept_until: ""
  # Laravel 存量令牌的绝对截止时刻，与上一条**分开**（不同兼容维度，分别删除）。
  laravel_accept_until: ""
  laravel:
    enabled: false
    secret: ""                     # 【密钥】
    algorithm: hs256

ssl:
  key: ""                          # 【文件挂载】私钥文件路径
  pem: ""                          # 【文件挂载】证书文件路径

# ---------------------------------------------------------------------------
# 资讯（news）
# ---------------------------------------------------------------------------
news:
  fsurl: ""                        # 资讯源地址
  appid: ""                        # 资讯应用 ID（非密钥）
  appsecret: ""                    # 【密钥】资讯应用密钥

# ---------------------------------------------------------------------------
# 阿里云短信
# 注意：这里是【扁平 key】（sms_access_id 等直接挂在 aliyun 下），不是嵌套的 sms: 块。
# sms.enabled=true 时，sms_access_id / sms_access_secret / sms_sign_name /
# sms_template_code 均为【必填】。
# ---------------------------------------------------------------------------
aliyun:
  sms_access_id: ""                # 【密钥】AccessKey ID
  sms_access_secret: ""            # 【密钥】AccessKey Secret
  sms_sign_name: ""                # 短信签名（非密钥）
  sms_template_code: ""            # 短信模板 code（非密钥）

# ---------------------------------------------------------------------------
# 百度语音
# ---------------------------------------------------------------------------
baidu:
  voice:
    appid: ""                      # 应用 ID（非密钥）
    apikey: ""                     # 【密钥】API Key
    secretkey: ""                  # 【密钥】Secret Key

# ---------------------------------------------------------------------------
# 跨域
# ---------------------------------------------------------------------------
cors:
  allowed_origins: []              # 允许的来源列表，空表示按代码默认策略

# ---------------------------------------------------------------------------
# pprof 性能剖析（默认关闭，仅排查性能问题时临时开启）
# 端点与业务服务物理隔离、绑独立端口；线上务必保持 host=127.0.0.1，通过 SSH 端口转发访问。
# ---------------------------------------------------------------------------
pprof:
  enabled: false                   # 是否启动独立 pprof 端点
  host: 127.0.0.1                  # 监听地址，强烈建议保持 127.0.0.1
  port: "6060"                     # 监听端口
  block_profile_rate: 0            # block profile 采样率（每 N 纳秒阻塞采样一次），0=关闭；排查典型值 10000
  mutex_profile_fraction: 0        # mutex profile 采样比例（1/N），0=关闭；排查典型值 100

# ---------------------------------------------------------------------------
# 可信代理 / 客户端 IP
#
# 【默认不信任任何代理】两个列表都留空时，客户端 IP 只取真实 TCP peer 地址，
# 请求里的 X-Forwarded-For / X-Real-IP 一律忽略。
#
# 为什么必须显式配置：框架默认信任所有代理，会直接采信这两个由客户端完全可控的 header——
# 任何人都能零成本把自己伪造成任意 IP，访问日志与业务审计里的 IP 因此不可信，
# 接上限流后攻击者轮换伪造 IP 即可无限绕过。
#
# 【部署在反向代理之后时必须配置】否则日志与审计记录到的会是代理自身的地址。
# 只填你确实控制的那一层代理网段，不要图省事写 0.0.0.0/0——生产环境会直接拒绝启动。
# ---------------------------------------------------------------------------
proxy:
  trusted_proxies: []              # 可信代理的 CIDR 或单个 IP；空=不信任任何代理
                                   # 例：["10.0.0.0/8"] 或 ["172.17.0.1"]
                                   # 生产禁止 0.0.0.0/0 与 ::/0（等价于回到不安全默认值）
  remote_ip_headers: []            # 允许用于提取客户端 IP 的转发头；仅当请求来自可信代理时才采信
                                   # 例：["X-Forwarded-For"]；不配置=不从任何 header 取 IP


# ---------------------------------------------------------------------------
# 限流
# ---------------------------------------------------------------------------
# **母版强制应用层限流：业务路由硬引用下面的默认策略。**
#
# 因此 policies **不能清空**——清空会让路由引用无法解析，进程启动失败。
# 那是刻意的：脚手架无从判断你的入口有没有网关，而"配置写了策略 ID 却不生效"
# 比启动失败坏得多——后者立刻被发现，前者要等到被打穿才知道。
#
# 上游已有 API Gateway / WAF 承担限流时，正确做法是把这里的速率调高到只作为
# 兜底上限，而不是删掉策略或从路由上摘掉引用。
#
# 下面给出的是一份**可直接使用**的默认策略，覆盖两个最常见的维度：
# 按来源（挡住单 IP 的暴力冲击）与按身份（挡住单账号滥用）。
# 一条路由可以同时引用多条，见 RouteSpec.RateLimitPolicyIDs。
#
# 注意 store: local 的多副本语义：**有效限额 = 配置值 × 副本数**。
# 它适合"高位防护上限"，不适合精确业务限额（如"每账号每分钟 5 次登录"）——
# 后者必须用 store: redis。
ratelimit:
  # 【密钥】限流键里主体标识（IP / userID）的 HMAC 密钥，>= 32 字节。
  # **必须专用**，禁止复用 JWT / 数据库 / 任何其他业务密钥。
  # 轮换语义：换密钥 = 所有桶重算 = 一次性限额重置（不做双密钥灰度）。
  key_hmac_secret: ""
  policies:
    # 按来源的高位防护：挡住单个 IP 的高频冲击。
    # store: local 因此不需要 Redis 就能生效——多副本下实际阈值是 20 × 副本数，
    # 作为"高位上限"这个放大可以接受；要精确就改 redis。
    - id: default.ip
      rate: 5                    # 每秒补 5 个
      burst: 20                  # 允许 20 的突发
      scope: ip
      store: local
      failure_mode: fail_closed  # 本地桶不会不可用，此处仅为显式声明
      max_keys: 100000           # 达上限拒绝新建，不淘汰活跃桶
    # 按身份的配额：只能挂在需鉴权的路由上（拿不到身份就退化成共享桶）。
    # 配置了 Redis 时把 store 改成 redis，可获得跨副本的精确限额。
    - id: default.user
      rate: 10
      burst: 50
      scope: user
      store: local
      failure_mode: fail_closed
      max_keys: 100000
    # 认证凭据端点（注册/登录）的专用额度。
    #
    # 【auth.mode: local 时必需】这几条是全站唯一接受口令猜测的入口，
    # 与读接口共用一个额度等于给爆破留出与正常浏览同样宽的通道。
    #
    # 只按来源限、不按身份：请求发生在拿到身份**之前**，此时没有可用的
    # 用户维度——按身份限流对未登录的爆破者不起任何作用。
    #
    # rate 0.2 = 每 5 秒补 1 个，burst 10 允许正常用户连续几次输错。
    # **配了 Redis 就把 store 改成 redis**：local 的实际阈值是配置值 ×
    # 副本数，副本一多，防爆破的额度就跟着放大了。
    - id: auth.credential
      rate: 0.2
      burst: 10
      scope: ip
      store: local
      failure_mode: fail_closed
      max_keys: 100000
    # 令牌端点（刷新/登出）的额度，可以宽一些：它们要求持有一个已签发的
    # 有效令牌，不构成口令猜测面。
    - id: auth.token
      rate: 1
      burst: 20
      scope: ip
      store: local
      failure_mode: fail_closed
      max_keys: 100000


# ---------------------------------------------------------------------------
# 业务模块配置
# ---------------------------------------------------------------------------
# 每个由生成器创建的模块在此有一段自己的子树，字段与 internal/platform/config/
# module_<name>.go 中的类型一一对应。根层是严格解码：这里写了代码里没有的键，
# 进程会直接启动失败——这正是要的行为，一个拼错的键名不该静默取默认值。
modules:
  user:
    # 注销档案保留天数。**没有默认值，必须由你决定**。
    #
    # 这张表存的是个人信息：注销前的手机号、邮箱、昵称与来源 IP。各行业与各
    # 司法辖区对最长保留期、删除权响应时限、以及"注销后仍需留存多久"的要求
    # 并不一致——脚手架替你选一个数字，只会让它在某些辖区是错的，而且是
    # **静默**错的（没有任何东西会提示你该值不合规）。
    #
    # 0 = 不自动清理，由外部流程负责。此时清理任务根本不会被注册——
    # 而不是注册一个什么都不做的任务在那里让人以为清理正在进行。
    #
    # 还需要一并落定的两件事，本配置管不了：
    #   · 谁能读这张表——靠数据库账号权限，应用层的读取限制绕不过直连的人；
    #   · 清理动作是否需要审计留痕。
    deactivation_retention_days: 0
    # 清理任务的执行间隔；留空按一天。
    deactivation_cleanup_interval: 24h
    # 单次清理的最大行数；<=0 按 500。
    #
    # 分批而不是一次删完：档案在长期运行的系统里可能积累到百万级，
    # 一条无界 DELETE 会长时间持有锁并撑大 binlog，而这个任务并不紧急。
    deactivation_cleanup_batch: 500
  # scaffold:module-config-example
